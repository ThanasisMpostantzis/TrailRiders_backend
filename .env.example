# Copy to .env and fill in the values

PORT=8000
# Public URL of this backend (used in the password-reset e-mail link)
BACKEND_URL=http://localhost:8000

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB=trailriders

# JWT secrets — use long random strings
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FORGOT_PASSWORD_TOKEN_SECRET=
SUBSCRIPTION_TOKEN_SECRET=
COMPANY_EVENT_TOKEN_SECRET=

# Gmail account + app password for the password-reset e-mails
MAIL=
MAIL_PASSWORD_APP=

# Google sign-in (optional). Comma separated OAuth client ids (web, android, ios)
# from Google Cloud Console. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=
